{
	"name": "anthropic-for-copilot",
	"displayName": "Anthropic Claude for Copilot Chat",
	"description": "Use Anthropic Claude (Sonnet 5, Opus 5, Fable 5.1) with 1M context in Copilot Chat with native vision, custom API Key, custom Base URL, reasoning, and agent tools.",
	"icon": "resources/icon.png",
	"version": "1.2.17",
	"publisher": "Luorj",
	"author": "Luorj",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/luorenjin/anthropic-for-copilot"
	},
	"engines": {
		"vscode": "^1.136.0",
		"node": ">=24"
	},
	"categories": [
		"AI",
		"Chat",
		"Programming Languages"
	],
	"keywords": [
		"anthropic",
		"claude",
		"claude 5",
		"sonnet 5",
		"opus 5",
		"fable 5.1",
		"copilot",
		"github copilot",
		"copilot chat",
		"vision",
		"byok",
		"language model",
		"thinking",
		"reasoning",
		"ai",
		"chat"
	],
	"activationEvents": [
		"onUri",
		"onStartupFinished"
	],
	"enabledApiProposals": [],
	"main": "./out/extension.js",
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "anthropic-copilot",
				"displayName": "Anthropic"
			}
		],
		"commands": [
			{
				"command": "anthropic-copilot.setApiKey",
				"title": "%anthropic-copilot.command.setApiKey%"
			},
			{
				"command": "anthropic-copilot.getApiKey",
				"title": "%anthropic-copilot.command.getApiKey%"
			},
			{
				"command": "anthropic-copilot.clearApiKey",
				"title": "%anthropic-copilot.command.clearApiKey%"
			},
			{
				"command": "anthropic-copilot.setVisionModel",
				"title": "%anthropic-copilot.command.setVisionModel%"
			},
			{
				"command": "anthropic-copilot.openSettings",
				"title": "%anthropic-copilot.command.openSettings%"
			},
			{
				"command": "anthropic-copilot.showLogs",
				"title": "%anthropic-copilot.command.showLogs%"
			},
			{
				"command": "anthropic-copilot.openRequestDumpsFolder",
				"title": "%anthropic-copilot.command.openRequestDumpsFolder%"
			}
		],
		"walkthroughs": [
			{
				"id": "anthropicGettingStarted",
				"title": "%anthropic-copilot.walkthrough.title%",
				"description": "%anthropic-copilot.walkthrough.description%",
				"steps": [
					{
						"id": "setApiKey",
						"title": "%anthropic-copilot.walkthrough.setApiKey.title%",
						"description": "%anthropic-copilot.walkthrough.setApiKey.description%",
						"media": {
							"markdown": "resources/walkthrough/set-api-key.md"
						},
						"completionEvents": [
							"onCommand:anthropic-copilot.setApiKey"
						]
					},
					{
						"id": "showModels",
						"title": "%anthropic-copilot.walkthrough.showModels.title%",
						"description": "%anthropic-copilot.walkthrough.showModels.description%",
						"media": {
							"markdown": "resources/walkthrough/show-models.md"
						}
					},
					{
						"id": "advancedSettings",
						"title": "%anthropic-copilot.walkthrough.advancedSettings.title%",
						"description": "%anthropic-copilot.walkthrough.advancedSettings.description%",
						"media": {
							"markdown": "resources/walkthrough/advanced-settings.md"
						}
					}
				]
			}
		],
		"configuration": {
			"title": "%anthropic-copilot.config.title%",
			"properties": {
				"anthropic-copilot.apiKey": {
					"type": "string",
					"default": "",
					"tags": [
						"language-models"
					],
					"markdownDescription": "%anthropic-copilot.config.apiKey.description%"
				},
				"anthropic-copilot.baseUrl": {
					"type": "string",
					"default": "https://api.anthropic.com",
					"tags": [
						"language-models"
					],
					"description": "%anthropic-copilot.config.baseUrl.description%"
				},
				"anthropic-copilot.maxTokens": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"tags": [
						"language-models"
					],
					"description": "%anthropic-copilot.config.maxTokens.description%"
				},
				"anthropic-copilot.experimental.stabilizeToolList": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%anthropic-copilot.config.experimental.stabilizeToolList.description%",
					"tags": [
						"language-models",
						"experimental"
					]
				},
				"anthropic-copilot.skillIndex.mode": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"off"
					],
					"markdownEnumDescriptions": [
						"%anthropic-copilot.config.skillIndex.mode.auto.description%",
						"%anthropic-copilot.config.skillIndex.mode.off.description%"
					],
					"markdownDescription": "%anthropic-copilot.config.skillIndex.mode.description%",
					"tags": [
						"language-models"
					]
				},
				"anthropic-copilot.skillIndex.threshold": {
					"type": "integer",
					"default": 128,
					"minimum": 0,
					"markdownDescription": "%anthropic-copilot.config.skillIndex.threshold.description%",
					"tags": [
						"language-models"
					]
				},
				"anthropic-copilot.skillIndex.maxRelevant": {
					"type": "integer",
					"default": 12,
					"minimum": 1,
					"maximum": 64,
					"markdownDescription": "%anthropic-copilot.config.skillIndex.maxRelevant.description%",
					"tags": [
						"language-models"
					]
				},
				"anthropic-copilot.modelIdOverrides": {
					"type": "object",
					"default": {},
					"tags": [
						"language-models"
					],
					"description": "%anthropic-copilot.config.modelIdOverrides.description%",
					"scope": "resource",
					"patternProperties": {
						"^.*$": {
							"type": "string"
						}
					},
					"additionalProperties": {
						"type": "string"
					},
					"properties": {
						"claude-fable-5-1": {
							"type": "string",
							"description": "%anthropic-copilot.config.modelIdOverrides.claude-fable-5.1.description%"
						},
						"claude-opus-5": {
							"type": "string",
							"description": "%anthropic-copilot.config.modelIdOverrides.claude-opus-5.description%"
						},
						"claude-sonnet-5": {
							"type": "string",
							"description": "%anthropic-copilot.config.modelIdOverrides.claude-sonnet-5.description%"
						},
						"claude-haiku-4-5": {
							"type": "string",
							"description": "%anthropic-copilot.config.modelIdOverrides.claude-haiku-4.5.description%"
						}
					}
				},
				"anthropic-copilot.customModels": {
					"type": "array",
					"default": [],
					"tags": [
						"language-models"
					],
					"description": "%anthropic-copilot.config.customModels.description%",
					"items": {
						"type": "object",
						"required": [
							"id",
							"name"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "Model ID in VS Code"
							},
							"name": {
								"type": "string",
								"description": "Display name in model picker"
							},
							"detail": {
								"type": "string",
								"description": "Model description"
							},
							"maxInputTokens": {
								"type": "number",
								"default": 1000000
							},
							"maxOutputTokens": {
								"type": "number",
								"default": 64000
							}
						}
					}
				},
				"anthropic-copilot.visionModel": {
					"type": "string",
					"default": "",
					"tags": [
						"language-models"
					],
					"markdownDescription": "%anthropic-copilot.config.visionModel.description%"
				},
				"anthropic-copilot.customHeaders": {
					"type": "object",
					"default": {},
					"tags": [
						"language-models"
					],
					"markdownDescription": "%anthropic-copilot.config.customHeaders.description%",
					"scope": "resource",
					"patternProperties": {
						"^.*$": {
							"type": "string"
						}
					},
					"additionalProperties": {
						"type": "string"
					}
				},
				"anthropic-copilot.debugMode": {
					"type": "string",
					"default": "minimal",
					"tags": [
						"language-models"
					],
					"enum": [
						"minimal",
						"metadata",
						"verbose"
					],
					"enumItemLabels": [
						"%anthropic-copilot.config.debugMode.minimal.label%",
						"%anthropic-copilot.config.debugMode.metadata.label%",
						"%anthropic-copilot.config.debugMode.verbose.label%"
					],
					"markdownEnumDescriptions": [
						"%anthropic-copilot.config.debugMode.minimal.description%",
						"%anthropic-copilot.config.debugMode.metadata.description%",
						"%anthropic-copilot.config.debugMode.verbose.description%"
					],
					"markdownDescription": "%anthropic-copilot.config.debugMode.description%"
				},
				"anthropic-copilot.useClaudeCodeSettings": {
					"type": "boolean",
					"default": true,
					"tags": [
						"language-models"
					],
					"markdownDescription": "%anthropic-copilot.config.useClaudeCodeSettings.description%"
				},
				"anthropic-copilot.authScheme": {
					"type": "string",
					"default": "auto",
					"tags": [
						"language-models"
					],
					"enum": [
						"auto",
						"bearer",
						"x-api-key"
					],
					"enumItemLabels": [
						"%anthropic-copilot.config.authScheme.auto.label%",
						"%anthropic-copilot.config.authScheme.bearer.label%",
						"%anthropic-copilot.config.authScheme.xApiKey.label%"
					],
					"markdownEnumDescriptions": [
						"%anthropic-copilot.config.authScheme.auto.description%",
						"%anthropic-copilot.config.authScheme.bearer.description%",
						"%anthropic-copilot.config.authScheme.xApiKey.description%"
					],
					"markdownDescription": "%anthropic-copilot.config.authScheme.description%"
				}
			}
		}
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
		"vscode:prepublish": "npm run compile",
		"compile": "npm run clean && tsc -p ./",
		"compile:tests": "tsc -p tests/tsconfig.json",
		"test": "npm run compile:tests && node --require ./tests/mock-vscode.js --test \"out/tests/unit/*.test.js\"",
		"watch": "npm run clean && tsc -watch -p ./",
		"lint": "oxlint",
		"format": "oxfmt --write src/",
		"format:check": "oxfmt --check src/",
		"package": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && vsce package -o dist/anthropic-for-copilot.vsix",
		"test:live": "npm run compile:tests && node --require ./tests/mock-vscode.js --test \"out/tests/live/*.test.js\""
	},
	"devDependencies": {
		"@types/node": "^26.6.1",
		"@types/vscode": "^1.136.0",
		"@vscode/vsce": "^4.0.0",
		"ovsx": "1.2.0",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.126.0"
	}
}
